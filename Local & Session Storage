//Local Storage ==> When browser is closed - data will be their.
// it will store up to 5mb to 10mb 


localStorage.setItem("name","sai");
localStorage.setItem("age",20);
console.log(localStorage.getItem("name"));
console.log(localStorage.getItem("age"));

localStorage.removeItem("name"); //one specific item is removed and it will give null output when we get the element.
console.log(localStorage.getItem("name"));

localStorage.clear(); // it will clear all the things and get the null element.
console.log(localStorage.getItem("age"));


